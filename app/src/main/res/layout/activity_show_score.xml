<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/score"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ScoreActivity"
    >

    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="@dimen/_45sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_4sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back"
        />




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_below="@id/imgBack"
        >


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lott"
            android:layout_width="@dimen/_170sdp"
            android:layout_height="@dimen/_150sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:scaleType="centerInside"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/congratulation4" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="মোট স্কোর : "
            android:letterSpacing="0.02"
            android:textColor="@color/colorBase"
            android:textSize="@dimen/_30ssp"
            android:fontFamily="@font/exo"
            android:textStyle="bold"
            />


        <TextView
            android:id="@+id/tvSubjectName"
            android:layout_marginTop="@dimen/_3ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="বিষয়ের নাম"
            android:fontFamily="@font/regular"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_14ssp"
            android:textStyle="normal"
            />


        <TextView
            android:id="@+id/txtscore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus10sdp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:text="১০০"
            android:textAlignment="center"
            android:textColor="@color/sky"
            android:textSize="@dimen/_55ssp"
            />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_marginTop="@dimen/_5ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="স্ট্যাটাস"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:fontFamily="@font/exo"
            android:textColor="@color/dark_grey"
            />

        <TextView
            android:id="@+id/firstMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_75sdp"
            android:layout_marginTop="@dimen/_35sdp"
            android:background="@drawable/btn_border"
            android:clickable="true"
            android:gravity="center"
            android:padding="@dimen/_10ssp"
            android:text="সাব মেনু"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/mainMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_75sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/red_button"
            android:clickable="true"
            android:gravity="center"
            android:padding="@dimen/_10ssp"
            android:text="মেইন মেনু"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp" />

    </LinearLayout>



</RelativeLayout>